{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 3,
      "url": [
        "/index.html",
        "/styleguide/index.html",
        "/services/index.html",
        "/services/sat/index.html",
        "/services/act/index.html",
        "/services/toefl/index.html",
        "/services/ielts/index.html",
        "/services/gre/index.html",
        "/services/professional-development/index.html",
        "/about/index.html",
        "/team/index.html",
        "/partners/index.html",
        "/ngo/index.html",
        "/ngo/styleguide/index.html",
        "/ngo/partners/index.html",
        "/ngo/about/index.html",
        "/ngo/program/index.html",
        "/ngo/contact/index.html",
        "/ngo/resources/index.html",
        "/ngo/resources/step-cohort-four-graduates/index.html",
        "/404.html"
      ],
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new --disable-dev-shm-usage --disable-gpu"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.96 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.9 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
