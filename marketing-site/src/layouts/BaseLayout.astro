---
/**
 * BaseLayout — the accessible, token-driven shell every page renders into.
 *
 * Provides the landmark skeleton (skip link → header/nav → main → footer) that gives
 * screen-reader users a high-level map of the page (WORKFLOW.md §2), sets the document
 * language, and exposes the per-brand theme hook via `data-brand` on <html>. The shared
 * masthead and footer are rendered here so every page reuses one shell (build plan Phase 0.4).
 *
 * The visual system is the token layer in src/styles (Phase 1); this layout only wires it up.
 */
import { Font } from 'astro:assets';
import '@styles/tokens.css';
import '@styles/base.css';
import SiteHeader from '@components/SiteHeader.astro';
import NgoSiteHeader from '@components/NgoSiteHeader.astro';
import SiteFooter from '@components/SiteFooter.astro';
import BrandSwitchLink from '@components/BrandSwitchLink.astro';

export interface Props {
  title: string;
  description?: string;
  /** Which brand theme this route belongs to. See WORKFLOW.md §3a. Defaults from the route:
   *  `/ngo/*` → 'ngo', everything else → 'consultancy'. Pass explicitly to override. */
  brand?: 'consultancy' | 'ngo';
}

const { title, description } = Astro.props;
// Path-derived default so every `/ngo/*` route gets data-brand="ngo" (and the NGO shell)
// without each page having to remember the prop; Consultancy root routes stay untouched.
const brand =
  Astro.props.brand ?? (Astro.url.pathname.startsWith('/ngo') ? 'ngo' : 'consultancy');
---

<!doctype html>
<html lang="en" data-brand={brand}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {/* GIEVA logotype webfont — emits @font-face + preloads the woff2 (Open Sans 400/600). */}
    <Font cssVariable="--font-open-sans" preload />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    {brand === 'ngo' ? <NgoSiteHeader /> : <SiteHeader />}
    {
      /* data-pagefind-body scopes the site-search index to real page content (the shared
        header/footer chrome is excluded); brand meta lets results carry a Consultancy/NGO
        tag. See SiteSearch.astro + the `pagefind` build step. */
    }
    <main
      id="main-content"
      data-pagefind-body
      data-pagefind-meta={`brand:${brand === 'ngo' ? 'NGO' : 'Consultancy'}`}
    >
      <slot />
    </main>
    <footer>
      <SiteFooter homeHref={brand === 'ngo' ? '/ngo' : '/'} brand={brand} />
    </footer>
    {
      /* Cross-site switcher. Outside <main> deliberately: it is shell chrome, so it stays out
        of the pagefind index and out of the page's own content landmark. It used to be authored
        into each Home hero, which meant the other 16 routes had no visible way across — see the
        component's header comment for the design provenance and the logged deviation. */
    }
    <BrandSwitchLink brand={brand} />
  </body>
</html>
