---
/**
 * Contact us (/ngo/contact) — NGO. Built against Figma node 7461:5854 ("CONTACT US PAGE NGO",
 * confirmed by frame name — no collision to resolve). See docs/ngo-build-plan.md Phase 5.
 *
 * ⚠ REDESIGNED — rebuilt 2026-08-07, the last page of the sweep that reworked About and Program.
 * The page was first built (Phase 5) against the 2026-07-20 ingest, which is what
 * design/figma/…/7461-5854/node.json still holds. That snapshot is STALE — it is 2660px tall
 * where the live frame is 2974px. This build follows the LIVE node, read through the Figma MCP;
 * every value below was confirmed against it, not against the committed node.json. Re-run
 * `npm run figma:fetch -- "<contact-url>"` (needs FIGMA_API_KEY) to resync. What changed:
 *   - A full-bleed photo hero + "Contact" h1 (node 12330:13424) replaced the white
 *     "HOME / PROGRAMS" breadcrumb header. The breadcrumb is gone from the design entirely,
 *     exactly as on About and Program — closing a11y issue N16 with the markup that carried it.
 *     Note the title is "Contact", not "Contact Us"; the design shortened it.
 * Nothing else about the frame's composition changed: the contact-info block and the form panel
 * are the same nodes at the same sizes. The remaining fixes below are parity bugs this pass
 * caught, not redesign deltas.
 *
 * SHAPE:
 *   1. Photo hero — `SubPageHero`, the same component Consultancy's seven sub-pages and NGO
 *      About/Program use: 1440×670, 25% black scrim, `u-page-title` 120px off the bottom. Its
 *      photo is byte-identical to About's and Program's (diffed at equal size, RMSE exactly 0),
 *      so it takes the shared `ngoHeroPhoto` rather than a second copy of anything.
 *   2. Contact info (node 7461:6164) — a two-column, icon-led block: HEAD OFFICE / LAGOS BRANCH
 *      OFFICE / JOS BRANCH OFFICE addresses on the left, PHONE / EMAIL / OFFICE HOURS on the
 *      right. Every micro-label ("HEAD OFFICE" etc.) sits inside a Figma frame with
 *      `opacity: 0.5` over its raw black (#000000) fill — not a distinct colour token — so the
 *      rendered value is flat black composited at 50% over the white surface, confirmed via
 *      `node.json` opacity as `#7F7F7F`. Icons (location pin, call, mail, clock) are the
 *      confirmed green `#007F0E` stroke glyphs; the call/mail/clock paths were re-diffed against
 *      the design's own SVG exports in this pass and match character-for-character (float
 *      rounding aside). The pin did not — see `.contact-info__icon`.
 *   3. "Send us a Message" — the deep-teal inverse form panel (node 7461:5938). Structurally the
 *      SAME 7-field labelled `<form>` as NGO Program's "Contact Us Now" panel (fixed 387px
 *      right-aligned label column, 122px gap, white-underline inputs, centred submit, muted
 *      teal-blue `#69A4B8` labels, green `.u-accent-em` heading accent) — confirmed against this
 *      page's own node rather than assumed. The only real deltas from Program's panel are the
 *      heading/subheading copy and three of the seven field labels being genuine ("What is your
 *      full name?" / "What is your email address?" / "Phone Number") rather than all seven
 *      reading the "What is your name?" placeholder — the last four still do, reproduced verbatim.
 *
 * GEOMETRY RECONCILES, so the reading above is verified rather than eyeballed: hero 670 + body
 * 1680 = Main 2350, and 2350 + the 624px footer = 2974, the measured frame. The body is one
 * 120px (`--space-6xl`) rhythm: 120 + info 300 + 120 + panel 1020 + 120 = 1680.
 *
 * TYPE: "Send us a Message" keeps `u-section-title`. Do NOT "fix" it to `u-h2` by analogy with
 * About — About moved because *its* headings specify tracking −0.26, whereas this frame's h2
 * (node 7461:5941) really does carry −3.3px, which is what `u-section-title` resolves to. The
 * hero title is `u-page-title` (64/56/700/−0.26), which is what node 12330:13794 specifies.
 *
 * Copy transcribed from the node's text runs, not eyeballed. Recurring-trap sweep: no hidden
 * `visible:false` runs on this page; no manual grid-anchor reordering (both info columns and all
 * form rows are document-order); no low-opacity-stroke dividers.
 *
 * Heading order: h1 "Contact" → h2 "Send us a Message". Nothing else on the page is a heading —
 * the office/phone/email/hours micro-labels are visual field-group labels, not section headings
 * (same precedent as the form `<label>`s themselves), so promoting them would only add
 * heading-order noise without a real content hierarchy to justify it.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Button from '@components/Button.astro';
import SubPageHero from '@components/SubPageHero.astro';
import { ngoHeroPhoto } from '@lib/ngo-hero-images';

const offices = [
  {
    label: 'HEAD OFFICE',
    address:
      'Lagos State House 3rd Floor Suite 329 Plot 78 Ralph Shodeinde Street CBD Abuja, Nigeria',
  },
  {
    label: 'LAGOS BRANCH OFFICE',
    address:
      '561 Agege Motor Road, Off Jacob Taiwo Street, Ladipo Bus Stop, Oshodi, Lagos, Nigeria.',
  },
  {
    label: 'JOS BRANCH OFFICE',
    address:
      'ECWA Production Building (Room 9), 10 Kano/Beach Road, Jos Plateau State, Nigeria.',
  },
];

const phones = ['+2347035250399', '+2347035250344', '+2348137533954'];
const officeHours = ['Monday - Thursday 9:00 AM - 4:00 PM', 'Friday 9:00 AM - 2:00 PM'];
const site = 'www.gieva.org';

interface ContactField {
  id: string;
  label: string;
  type: 'text' | 'email' | 'tel';
  autocomplete?: string;
}

// Seven fields (node 7461:5944): the first three are genuine, the last four all read the
// "What is your name?" placeholder in the source — reproduced verbatim, each wired to a
// uniquely-id'd input so the label→input association stays valid.
const contactFields: ContactField[] = [
  {
    id: 'contact-full-name',
    label: 'What is your full name?',
    type: 'text',
    autocomplete: 'name',
  },
  {
    id: 'contact-email',
    label: 'What is your email address?',
    type: 'email',
    autocomplete: 'email',
  },
  { id: 'contact-phone', label: 'Phone Number', type: 'tel', autocomplete: 'tel' },
  { id: 'contact-4', label: 'What is your name?', type: 'text' },
  { id: 'contact-5', label: 'What is your name?', type: 'text' },
  { id: 'contact-6', label: 'What is your name?', type: 'text' },
  { id: 'contact-7', label: 'What is your name?', type: 'text' },
];
---

<BaseLayout
  title="Contact Us — GIEVA NGO"
  description="Reach GIEVA's head office, Lagos and Jos branch offices, phone lines, and email — or send us a message about how we can impact lives together."
  brand="ngo"
>
  <!-- ── Photo hero (node 12330:13424) ────────────────────────────────────────── -->
  <SubPageHero title="Contact" photo={ngoHeroPhoto} />

  <div class="container contact">
    <!-- ── Contact info ───────────────────────────────────────────────────────── -->
    <section class="contact-info">
      <div class="contact-info__col">
        {
          offices.map((office) => (
            <div class="contact-info__group">
              <p class="u-label contact-info__label">{office.label}</p>
              <p class="contact-info__row contact-info__row--address">
                <svg
                  class="contact-info__icon"
                  width="16"
                  height="16"
                  viewBox="0 0 16 16"
                  fill="none"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path
                    d="M13.3346 6.6663C13.3346 9.6119 8.0013 14.6663 8.0013 14.6663C8.0013 14.6663 2.66797 9.6119 2.66797 6.6663C2.66797 3.72082 5.05578 1.33301 8.0013 1.33301C10.9468 1.33301 13.3346 3.72082 13.3346 6.6663Z"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                  <path
                    d="M7.9987 7.3333C8.3669 7.3333 8.66536 7.0349 8.66536 6.6667C8.66536 6.2985 8.3669 6 7.9987 6C7.6305 6 7.33203 6.2985 7.33203 6.6667C7.33203 7.0349 7.6305 7.3333 7.9987 7.3333Z"
                    fill="currentColor"
                  />
                </svg>
                <span>{office.address}</span>
              </p>
            </div>
          ))
        }
      </div>

      <div class="contact-info__col">
        <div class="contact-info__group">
          <p class="u-label contact-info__label">PHONE</p>
          <p class="contact-info__row">
            <svg
              class="contact-info__icon"
              width="16"
              height="16"
              viewBox="0 0 16 16"
              fill="none"
              aria-hidden="true"
              focusable="false"
            >
              <path
                d="M6.1055 3.80815L5.83707 3.20417C5.66155 2.80925 5.57379 2.61179 5.44254 2.46067C5.27805 2.27129 5.06364 2.13196 4.82378 2.05857C4.63239 2 4.4163 2 3.98414 2C3.35194 2 3.03584 2 2.77048 2.12153C2.45791 2.26468 2.17562 2.57552 2.06315 2.9004C1.96767 3.17619 1.99502 3.45962 2.04972 4.02647C2.63194 10.0601 5.93988 13.368 11.9735 13.9503C12.5404 14.005 12.8238 14.0323 13.0996 13.9368C13.4245 13.8244 13.7353 13.5421 13.8785 13.2295C14 12.9642 14 12.648 14 12.0158C14 11.5837 14 11.3676 13.9414 11.1762C13.868 10.9364 13.7287 10.722 13.5393 10.5574C13.3882 10.4262 13.1908 10.3384 12.7958 10.1629L12.1918 9.89451C11.7642 9.70444 11.5503 9.60937 11.333 9.58871C11.125 9.56891 10.9154 9.59811 10.7207 9.67391C10.5173 9.75311 10.3376 9.90291 9.97797 10.2026C9.6201 10.5008 9.44117 10.6499 9.2225 10.7298C9.02864 10.8006 8.77237 10.8268 8.56824 10.7968C8.3379 10.7628 8.16157 10.6686 7.80884 10.4801C6.7115 9.89364 6.10635 9.28851 5.51991 8.19117C5.33143 7.83844 5.23718 7.66211 5.20324 7.43177C5.17316 7.22764 5.19938 6.97137 5.2702 6.77751C5.35008 6.55885 5.49921 6.37991 5.79746 6.022C6.09708 5.66245 6.24689 5.48268 6.3261 5.27927C6.4019 5.08463 6.43108 4.87493 6.4113 4.66699C6.39063 4.44968 6.29558 4.23584 6.1055 3.80815Z"
                stroke="currentColor"
                stroke-linecap="round"></path>
            </svg>
            <span class="contact-info__phones">
              {
                phones.map((phone) => (
                  <a class="contact-info__link" href={`tel:${phone}`}>
                    {phone}
                  </a>
                ))
              }
            </span>
          </p>
        </div>

        <div class="contact-info__group">
          <p class="u-label contact-info__label">EMAIL</p>
          <p class="contact-info__row">
            <svg
              class="contact-info__icon"
              width="16"
              height="16"
              viewBox="0 0 16 16"
              fill="none"
              aria-hidden="true"
              focusable="false"
            >
              <path
                d="M1.33203 4L5.94071 6.61131C7.63976 7.574 8.35763 7.574 10.0567 6.61131L14.6654 4"
                stroke="currentColor"
                stroke-linejoin="round"></path>
              <path
                d="M1.34254 8.98341C1.38612 11.0271 1.40792 12.0489 2.162 12.8059C2.91608 13.5629 3.96558 13.5892 6.06458 13.6419C7.35823 13.6745 8.63916 13.6745 9.93283 13.6419C12.0318 13.5892 13.0813 13.5629 13.8354 12.8059C14.5895 12.0489 14.6113 11.0271 14.6548 8.98341C14.6689 8.32628 14.6689 7.67308 14.6548 7.01594C14.6113 4.97225 14.5895 3.9504 13.8354 3.19345C13.0813 2.4365 12.0318 2.41013 9.93283 2.35739C8.63916 2.32488 7.35823 2.32488 6.06458 2.35738C3.96558 2.41012 2.91608 2.43648 2.162 3.19344C1.40791 3.9504 1.38612 4.97224 1.34254 7.01594C1.32852 7.67308 1.32853 8.32628 1.34254 8.98341Z"
                stroke="currentColor"
                stroke-linejoin="round"></path>
            </svg>
            <a class="contact-info__link" href={`https://${site}`}>{site}</a>
          </p>
        </div>

        <div class="contact-info__group">
          <p class="u-label contact-info__label">OFFICE HOURS</p>
          {
            officeHours.map((hours) => (
              <p class="contact-info__row">
                <svg
                  class="contact-info__icon"
                  width="16"
                  height="16"
                  viewBox="0 0 16 16"
                  fill="none"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path
                    d="M8 5.33301V7.99967L9 8.99967"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                  <path
                    d="M13.0316 10.9689C14.1225 11.558 14.668 11.8526 14.668 12.3333C14.668 12.814 14.1225 13.1086 13.0316 13.6977L12.2887 14.0989C11.4509 14.5513 11.032 14.7775 10.8306 14.613C10.3373 14.2102 11.1058 13.1707 11.2948 12.8024C11.4864 12.4293 11.483 12.2306 11.2948 11.8642C11.1058 11.4959 10.3373 10.4564 10.8306 10.0536C11.032 9.88911 11.4509 10.1153 12.2887 10.5677L13.0316 10.9689Z"
                    stroke="currentColor"
                  />
                  <path
                    d="M8.68276 14.6317C8.4579 14.6546 8.22963 14.6663 7.9987 14.6663C4.3168 14.6663 1.33203 11.6815 1.33203 7.99967C1.33203 4.31777 4.3168 1.33301 7.9987 1.33301C11.6806 1.33301 14.6654 4.31777 14.6654 7.99967C14.6654 8.45627 14.6194 8.90221 14.532 9.33301"
                    stroke="currentColor"
                    stroke-linecap="round"
                  />
                </svg>
                <span>{hours}</span>
              </p>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ── Send us a Message ─────────────────────────────────────────────────── -->
    <section class="contact-form surface-inverse" id="contact-form" data-surface="inverse">
      <div class="contact-form__header">
        <h2 class="u-section-title">
          Send us a <em class="u-accent-em">Message</em>
        </h2>
        <p class="u-body-lg">
          Answer Interview questions to help us know how we can impact lives together
        </p>
      </div>

      <form class="contact-form__body">
        <div class="contact-form__fields">
          {
            contactFields.map((field) => (
              <>
                <label class="contact-form__label u-body-lg" for={field.id}>
                  {field.label}
                </label>
                <div class="contact-form__control">
                  <input
                    id={field.id}
                    class="contact-form__input u-body-lg"
                    type={field.type}
                    name={field.id}
                    placeholder="Your Answer"
                    autocomplete={field.autocomplete}
                    required
                  />
                </div>
              </>
            ))
          }
        </div>
        <div class="contact-form__submit">
          <Button variant="primary" type="submit">Send Message</Button>
        </div>
      </form>
    </section>
  </div>
</BaseLayout>

<style>
  /* ── Page flow ────────────────────────────────────────────────────────────────
     The body below the hero is node 7461:5857: 120px padding top and bottom, and 120px between
     the info block and the panel (--space-6xl, matching itemSpacing) — so, like Program, it is
     one grid with a uniform row-gap rather than per-section double-padding. The top padding used
     to exist to clear the old in-flow page header; post-redesign it is the node's own padding.
     120 + 300 + 120 + 1020 + 120 = 1680, the measured height of the node. */
  .contact {
    display: grid;
    padding-top: var(--space-6xl);
    padding-bottom: var(--space-6xl);
    row-gap: var(--space-6xl);
  }

  /* ── Contact info ─────────────────────────────────────────────────────────────
     node 7461:6164: two 636px columns, 40px gap. Each column is a 24px-gap vertical stack of
     label+row groups (node itemSpacing 24); within a group, label→row(s) are 16px apart. */
  .contact-info {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-xl);
  }
  .contact-info__col {
    display: grid;
    gap: var(--space-md);
  }
  /* Every group carries an 8px horizontal inset (node 7461:6194 etc. paddingLeft/Right 8), so
     the block's text starts 8px in from the container edge rather than flush with it. */
  .contact-info__group {
    display: grid;
    gap: var(--space-sm);
    padding-inline: var(--space-2xs);
  }
  /* All-caps micro-label ("HEAD OFFICE", "PHONE"…). The type is the design's own named style
     "GIEVA.org/Arial/Narrow" (Arial Narrow 14/20/400, tracking −0.14), which is exactly the
     `--type-label-*` role — hence `.u-label` rather than a hand-rolled copy. The colour is the
     one thing that isn't a token: the node's text fill is flat black, but every label sits
     inside a frame with opacity 0.5. Flattened against the white surface that's #7F7F7F, a
     tracked colour-contrast gap (issue N17, docs/a11y-known-issues.md) — not a translation
     guess. */
  .contact-info__label {
    margin: 0;
    color: #7f7f7f;
  }
  /* The phone, email and office-hours rows are `items-center` in the design (nodes 7461:6175 /
     6249 / 6258): single-line copy, so the 16px glyph centres in the 24px line box. */
  .contact-info__row {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    margin: 0;
    font-size: var(--type-body-lg-size);
    line-height: var(--type-body-lg-line);
    letter-spacing: var(--type-body-lg-tracking);
    color: #000; /* node fill #000000 — not NGO's violet default ink */
  }
  /* The three address rows are the exception — `items-start` with the pin nudged 4px down
     (node I7461:6198;4547:22453 paddingTop 4), because their copy wraps to two lines and the
     pin belongs beside the first one, not centred across both. */
  .contact-info__row--address {
    align-items: flex-start;
  }
  .contact-info__row--address .contact-info__icon {
    margin-top: var(--space-3xs);
  }
  /* Icons are the confirmed green stroke glyphs (node fill/stroke #007F0E on every pin/call/
     mail/clock instance) — decorative and redundant with the adjoining text.

     All four are 16×16 in the design. The pin used to be authored 16×20 with its glyph sitting
     in the bottom 15px of that box — a 24-space icon dropped into the wrong viewBox — which
     rendered it ~4px low and made the row reserve 20px. Re-diffed against the design's own SVG
     export in this pass and re-anchored: shifting every y by −4 puts the outline at y 1.33–14.67
     and the dot at 6.0–7.33, which is the export's 8.33%/37.5% insets exactly. */
  .contact-info__icon {
    flex: none;
    color: var(--color-cta);
  }
  .contact-info__phones {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--space-2xs);
    row-gap: var(--space-3xs);
  }
  .contact-info__link {
    color: inherit;
    text-decoration: none;
  }
  .contact-info__link:hover {
    text-decoration: underline;
  }
  .contact-info__link:focus-visible {
    outline: 3px solid var(--color-focus-ring);
    outline-offset: 2px;
  }
  /* The phone and website rows were 24px tall only because `--type-body-lg` carries a 24px
     line-height; the mobile tier drops that role to 14/20 (tokens.css §4), which would leave
     these under the 24×24 WCAG 2.5.8 AA floor. Padding restores the target, the equal negative
     margin hands the space back so the row's 4px `row-gap` rhythm is unchanged. Same fix, same
     reason, as the footer's contact links. */
  @media (max-width: 640px) {
    .contact-info__link {
      display: block;
      padding-block: 2px;
      margin-block: -2px;
    }
  }

  /* ── Send us a Message ────────────────────────────────────────────────────────
     Deep-teal inverse panel (#0E3E40), 12px radius, 64px padding + 64px gap between header /
     fields / submit — identical shape to Program's "Contact Us Now" panel. */
  .contact-form {
    padding: var(--space-3xl);
    border-radius: var(--radius-md);
    display: grid;
    gap: var(--space-3xl);
  }
  .contact-form__header {
    display: grid;
    gap: var(--space-sm);
    justify-items: center;
    text-align: center;
  }
  .contact-form__header h2 {
    margin: 0;
  }
  .contact-form__body {
    display: grid;
    gap: var(--space-3xl);
  }
  /* Fixed 387px label column, RIGHT-aligned text, 122px gap to a filling input (node: Label
     sizingH FIXED w=387, row itemSpacing 122) — the same one-off values as the NGO
     Partners/Program forms. Rows are 16px apart (node itemSpacing 16).

     Each row is a FIXED 74px, which is taller than its own content: the input box is only 42px
     of it (node 7461:5949) and the remaining 32px is empty. Letting the rows size to content
     instead — which is what they did until this pass — collapses each one to 42px and the whole
     panel to 796px against the frame's measured 1020px. The arithmetic is 7 × 74 + 6 × 16 = 614,
     which is the measured height of node 7461:5944 exactly, and
     64 + 96 + 64 + 614 + 64 + 54 + 64 = 1020, the panel. Top-align, or the 32px splits itself
     around the input and the underline drifts off the design's baseline. Same fix as Program. */
  .contact-form__fields {
    display: grid;
    grid-template-columns: 387px minmax(0, 1fr);
    column-gap: 122px;
    row-gap: var(--space-sm);
    grid-auto-rows: 74px;
    align-items: start;
  }
  /* Muted teal-blue labels #69A4B8 (node fill) — same colour as Program's Contact panel, not
     Partners' green. The 8px offset is the label text's y within its own 74px row cell (node
     7461:5946 paddingTop 8), which lines its baseline up with the input's text rather than with
     the top of the input box. */
  .contact-form__label {
    color: #69a4b8;
    text-align: right;
    padding-top: var(--space-2xs);
  }
  .contact-form__control {
    display: flex;
  }
  /* The input box's padding is asymmetric in the design — 8px top, 10px bottom (node 7461:5949)
     — which is what makes it 42px around a 24px line. Not a typo. */
  .contact-form__input {
    width: 100%;
    background: transparent;
    border: 0;
    border-bottom: 2px solid var(--color-white);
    padding-top: var(--space-2xs);
    padding-bottom: 10px;
    color: var(--color-text-inverse);
    font-family: var(--font-family-base);
  }
  /* The placeholder run sits in a frame at opacity 0.5 (node 7461:5950), so "Your Answer" is
     white at 50% over the teal — #879FA0, 4.21:1, which is a tracked colour-contrast gap
     (issue N20, docs/a11y-known-issues.md) rather than an accident. Shipped as designed on the
     client's call; the full-opacity white it replaced measured 11.79:1. */
  .contact-form__input::placeholder {
    color: var(--color-text-inverse);
    opacity: 0.5;
  }
  .contact-form__input:focus-visible {
    outline: 3px solid var(--color-focus-ring);
    outline-offset: 4px;
  }
  .contact-form__submit {
    display: flex;
    justify-content: center;
  }

  /* ── Responsive ───────────────────────────────────────────────────────────────
     No tablet/mobile NGO Contact frame exists in the design; these are our authored,
     content-preserving reflows (same approach as the other NGO pages). */
  @media (max-width: 1024px) {
    .contact-form__fields {
      grid-template-columns: 220px minmax(0, 1fr);
      column-gap: var(--space-3xl);
    }
  }
  @media (max-width: 900px) {
    .contact-info {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
    }
  }
  @media (max-width: 640px) {
    .contact-form {
      padding: var(--space-lg);
      gap: var(--space-2xl);
    }
    .contact-form__body {
      gap: var(--space-2xl);
