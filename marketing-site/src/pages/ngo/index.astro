---
/**
 * Home (/ngo) — NGO. Built against the committed Figma node 5990:3672
 * (design/figma/fTqnnV20l9htP7vFJrOsvn/5990-3672/), see docs/ngo-build-plan.md.
 *
 * Shares the Consultancy Home skeleton (hero + partners marquee, who-we-are + stats band,
 * card grid, testimonial, CTA) but re-themed via [data-brand='ngo'] tokens and with NGO's own
 * content/section set: a 2×2 programs grid, a video "success stories" block, a single-card
 * testimonial, and a recent-news row. Copy is transcribed from the node.json text runs; the
 * bold-italic accent phrases live in characterStyleOverrides and render GREEN on NGO (the
 * inverse of Consultancy's orange — see tokens.css --color-heading-accent).
 *
 * Two of its blocks are CMS-driven: the Recent News row (`@lib/articles`, 2026-08-11) and the
 * 2×2 **programs grid as of 2026-08-15** (`@lib/programs`, the same list `/ngo/program` details
 * — see the `programs` const and that module for the four-versus-three mismatch it settles).
 * Both ship the design's own content as fixtures, so a build with no `GIEVA_API_URL` renders
 * this page exactly as the frame does.
 *
 * The shell (NgoSiteHeader + SiteFooter) is finalized against this frame here; the only shell
 * token correction Home surfaced was the eyebrow↔accent colour inversion (tokens.css/base.css).
 *
 * The closing CTA is `NgoCtaSection`, shared with /ngo/about — this page's copy of the markup
 * and CSS moved there, and with it went two corrections this page had been rendering: the rows
 * are `Button`s (the design's `GIEVA Button` instances) rather than hand-rolled anchors with a
 * hand-drawn arrow, and the heading is `u-h2` rather than `u-section-title`. Both are measured
 * off the live frame; see the component for the evidence.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Button from '@components/Button.astro';
import PartnersMarquee from '@components/PartnersMarquee.astro';
import NgoCtaSection from '@components/NgoCtaSection.astro';
import StatCounter from '@components/StatCounter.astro';
import ArticleCard from '@components/ArticleCard.astro';
import { getArticles } from '@lib/articles';
import { getHomePrograms } from '@lib/programs';
import { Image } from 'astro:assets';
// Both homes share the same real partner set (node 12023:32440); the NGO-specific glob was
// removed as its per-logo identities were unverified placeholders.
import { partnerLogos } from '@lib/home-images';
import { ngoHeroRing, boatPhoto, testimonialPortrait } from '@lib/ngo-home-images';

const stats = [
  { value: '10,000+', label: 'Lives Changed' },
  { value: '30+', label: 'Global Partners' },
  { value: '12+', label: 'Years Active' },
  { value: '98%', label: 'Success Rate' },
];

/**
 * The program cards (node 5990:3672) — CMS-driven as of 2026-08-15, from the same list
 * `/ngo/program` details. The design's own four live on as `@lib/programs`' Home fixtures, so a
 * build with no `GIEVA_API_URL` renders this grid exactly as designed.
 *
 * The hrefs come from the CMS `slug` now, which is what makes them honest. They used to be
 * guesses, and only two of four could be deep-linked: `/ngo/program` details THREE programmes
 * (STEP, HEALS, GVP — node 7447:6027) against Home's four, CHOICES has no section there at all,
 * and PARTNERSHIP PROGRAMS is titled for partnerships while carrying HEALS's expansion as its
 * blurb. That is the design's own inconsistency, so those two kept pointing at the Programs page
 * root rather than at an invented anchor. With one published list behind both surfaces the
 * mismatch cannot recur — Home shows the first four of exactly what that page details, so every
 * `#slug` has a section to land on. The fixtures still carry the design's four, root links and
 * all; see `@lib/programs` for why the two fixture sets are allowed to disagree.
 */
const programs = await getHomePrograms();

const testimonial = {
  quote:
    "The GIEVA team walked me through every step of my TOEFL registration. They even helped me pick test centres I didn't know existed. I got my scores in record time and reported them to my target schools the same week.",
  name: 'Tolulope Ogunwale',
  role: 'TOEFL CLIENT',
  detail: 'Admitted to University of Michigan',
};

/**
 * The three most recent NGO articles, from the CMS at build time.
 *
 * Was three copies of one hard-coded placeholder ("PSPBA Hosts Plateau Peace Architecture Forum
 * PPAF 2025", tag "Publication", all three linking to `/ngo/resources`) transcribed from the
 * frame's text runs. Now real content, and each card links to its own article — which closes
 * four of the eleven inbound links to `/ngo/resources` that had nowhere to land.
 *
 * `getArticles` returns the API's own ordering (pinned, then featuredOrder, then publishedAt
 * desc), so `slice(0, 3)` is "the three the client has chosen to surface", not merely the newest.
 */
const news = (await getArticles('ngo')).slice(0, 3);
---

<BaseLayout
  title="GIEVA NGO — Transforming Lives, One Youth at a Time"
  description="Four flagship programs, 30+ global partners, and 18 years of impact across Nigeria. Join GIEVA as a donor, volunteer, or partner."
  brand="ngo"
>
  <!-- ── Hero ─────────────────────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__content">
        <span class="hero__badge">NGO</span>
        <h1 class="u-hero hero__heading">
          Transforming Lives,<br /><em class="u-accent-em">One Youth at a Time.</em>
        </h1>
        <p class="u-body-lg hero__lead">
          Four flagship programs, 30+ global partners, and 18 years of impact across Nigeria.
          Join us — as a donor, volunteer, or partner.
        </p>
        <div class="hero__actions">
          <Button variant="primary" href="/ngo/get-involved">Get Involved</Button>
          <Button variant="secondary" href="/ngo/donate">Donate</Button>
        </div>
      </div>

      <div class="hero__visual">
        <Image src={ngoHeroRing} alt="" width={818} height={818} class="hero__ring" />
        {
          /* The "Explore Consultancy" pill (node 5990:4604) now lives in BrandSwitchLink.astro,
            rendered by BaseLayout on every route. */
        }
      </div>
    </div>

    <PartnersMarquee logos={partnerLogos} />
  </section>

  <!-- ── Who We Are ───────────────────────────────────────────────────────────── -->
  <section class="section who">
    <div class="container who__grid">
      <div class="who__intro">
        <p class="u-eyebrow">Who We Are</p>
        <h2 class="u-section-title">
          Global Integrated Education Volunteers Association (GIEVA)
        </h2>
      </div>
      <div class="who__body">
        <p class="u-body-lg">
          Global Integrated Education Volunteers Association (GIEVA) was registered in 2006 as
          a nonprofit organization to improve access to quality education and global learning
          opportunities among young Nigerians. Over the years, GIEVA has grown to serve over
          1,000 young Nigerians annually, with a strong focus on inclusive education, digital
          empowerment, and youth development.
        </p>
        <Button variant="secondary" href="/ngo/about">Learn more about us</Button>
      </div>
    </div>

    <div class="container">
      <div class="who__photo-wrap">
        <Image src={boatPhoto} alt="" width={1312} height={670} class="who__photo" />
        <ul role="list" class="who__stats">
          {
            stats.map((stat, i) => (
              <li class="who__stat" data-divider={i > 0 ? '' : undefined}>
                <p class="u-h2 who__stat-value">
                  <StatCounter value={stat.value} />
                </p>
                <p class="who__stat-label">{stat.label}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- ── Our Programs ──────────────────────────────────────────────────────────────
       Rendered only when the CMS has published programmes — same call as the news row below and
       as Consultancy Home's Core Team and FAQ: "Initiatives Built for Real Impact" above an
       empty grid is worse than no section at all. Only reachable with a configured-but-empty
       CMS; fixtures always have four. -->
  {
    programs.length > 0 && (
      <section class="section programs">
        <div class="container">
          <div class="programs__intro">
            <p class="u-eyebrow">Our Programs</p>
            <h2 class="u-section-title">
              Initiatives Built for <em class="u-accent-em">Real Impact</em>
            </h2>
            <p class="u-body-lg">
              Community-centered, measurable, and designed for long-term change across Nigeria.
            </p>
          </div>

          <ul role="list" class="programs__grid">
            {programs.map((program) => (
              <li class="programs__card surface-inverse" data-surface="inverse">
                <div class="programs__card-head">
                  <h3 class="programs__card-title">{program.title}</h3>
                  <span class="programs__divider" aria-hidden="true" />
                  <p class="u-body-lg programs__card-desc">{program.tagline}</p>
                </div>
                <Button variant="link" href={program.href}>
                  Learn more
                </Button>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- ── Success Stories ──────────────────────────────────────────────────────── -->
  <section class="section success">
    <div class="container">
      <div class="success__intro">
        <p class="u-eyebrow">Success Stories</p>
        <h2 class="u-section-title">
          Real-Life Stories of <em class="u-accent-em">Impacts made</em>
        </h2>
        <p class="u-body-lg">
          Community-centered, measurable, and designed for long-term change across Nigeria.
        </p>
      </div>

      <a class="success__video" href="/ngo/resources">
        <Image src={boatPhoto} alt="" width={1312} height={688} class="success__video-img" />
        <span class="success__play" aria-hidden="true">
          <svg width="26" height="30" viewBox="0 0 26 30" fill="none" focusable="false">
            <path
              d="M25 13.27a2 2 0 0 1 0 3.46L3 29.4a2 2 0 0 1-3-1.73V2.33A2 2 0 0 1 3 .6l22 12.67Z"
              fill="currentColor"></path>
          </svg>
        </span>
        <span class="visually-hidden">Watch our success stories</span>
      </a>

      <figure class="testimonial surface-inverse" data-surface="inverse">
        <Image
          src={testimonialPortrait}
          alt=""
          width={437}
          height={508}
          class="testimonial__photo"
        />
        <div class="testimonial__body">
          <blockquote class="testimonial__quote">
            <span class="testimonial__mark" aria-hidden="true">&ldquo;</span>
            <p>{testimonial.quote}</p>
          </blockquote>
          <div class="testimonial__attribution">
            <span class="testimonial__divider" aria-hidden="true"></span>
            <figcaption>
              <p class="testimonial__name">{testimonial.name}</p>
              <p class="testimonial__role">
                <span>{testimonial.role}</span>
                <span>{testimonial.detail}</span>
              </p>
            </figcaption>
            <Button variant="link" href="/ngo/resources">View case study</Button>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <!-- ── Recent News ──────────────────────────────────────────────────────────────
       The whole section is conditional on there being articles. The design always draws three
       cards, but the CMS starts empty and this is Home — an intro reading "Keep Up With Us"
       above an empty grid and a "See all news" button leading to an empty index is worse than
       not running the section at all. With content, it renders exactly as the frame does. -->
  {
    news.length > 0 && (
      <section class="section news">
        <div class="container">
          <div class="news__panel">
            <div class="news__intro">
              <p class="u-eyebrow">Recent News</p>
              <h2 class="u-section-title">
                Keep Up <em class="u-accent-em">With Us</em>
              </h2>
              <p class="u-body-lg">
                Community-centered, measurable, and designed for long-term change across
                Nigeria.
              </p>
            </div>

            <ul role="list" class="news__grid">
              {news.map((article) => (
                <ArticleCard article={article} basePath="/ngo/resources" headingLevel={3} />
              ))}
            </ul>

            <div class="news__more">
              <Button variant="primary" href="/ngo/resources">
                See all news
              </Button>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- ── CTA (node 5990:4479) — shared with /ngo/about, see NgoCtaSection.astro ── -->
  <section class="section cta">
    <div class="container">
      <NgoCtaSection />
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Shared section rhythm ──────────────────────────────────────────────── */
  .section {
    padding-block: var(--section-padding-block);
  }

  /* ── Hero ───────────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    background-image: repeating-linear-gradient(
      to right,
      rgb(0 0 0 / 0.02) 0,
      rgb(0 0 0 / 0.02) 1px,
      transparent 1px,
      transparent 60px
    );
  }
  .hero {
    overflow: hidden;
  }
  /*
   * Columns/gap match the Consultancy hero (656 + 48 inside the 1312px container),
   * which is what leaves the mark its 608px. The NGO frame does not specify a
   * two-column hero at all — node 5990:3698 is a full-width overlay stacked on the
   * `logo image` — so the previous 600/24 split was an approximation, not a measured
   * value. The copy is unaffected: .hero__heading and .hero__lead are capped in `ch`,
   * well inside either column width.
   */
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 656px) 1fr;
    align-items: center;
    gap: var(--space-2xl);
    padding-block: var(--space-5xl) var(--space-2xl);
  }
  .hero__content {
    display: grid;
    gap: var(--space-lg);
  }
  .hero__badge {
    display: inline-block;
    width: fit-content;
    padding: var(--space-3xs) var(--space-md);
    border: 1px solid var(--color-periwinkle);
    border-radius: var(--radius-sm);
    font-size: var(--type-body-size);
    color: var(--color-mine-shaft);
    text-transform: uppercase;
    letter-spacing: var(--type-eyebrow-tracking);
  }
  .hero__heading {
    color: var(--color-text-default);
    max-width: 16ch;
  }
  .hero__lead {
    color: var(--color-text-default);
    max-width: 48ch;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .hero__visual {
    position: relative;
  }
  /*
   * Sized to match the Consultancy hero's mark rather than bleeding off the viewport
   * (client direction, 2026-08-25). The grid above supplies the width — this is the
   * same rule Consultancy's .hero__ring carries — so the two marks paint identically
   * at every viewport, not just at the container's max.
   *
   * Deliberate deviation from node 5990:3672, where `logo image` (5990:3677) is the
   * 818px rectangle clipped to 780 at the frame's right edge. The previous
   * `width: 115%` + negative gutter margin reproduced that bleed and is what made
   * this mark render ~30% larger than Consultancy's. Logged in docs/ngo-build-plan.md.
   */
  .hero__ring {
    width: 100%;
    height: auto;
  }
  /* The cross-site "Explore Consultancy" pill's styles moved to BrandSwitchLink.astro. */

  /* ── Who We Are ─────────────────────────────────────────────────────────── */
  .who__grid {
    display: grid;
    grid-template-columns: minmax(0, 640px) 1fr;
    gap: var(--space-xl);
    margin-bottom: var(--space-4xl);
  }
  .who__intro,
  .who__body {
    display: grid;
    gap: var(--space-sm);
    align-content: start;
  }
  .who__intro h2 {
    color: var(--color-text-default);
  }
  .who__body p {
    color: var(--color-text-default);
    margin-bottom: var(--space-sm);
  }
  .who__body :global(.btn) {
    justify-self: start;
  }

  .who__photo-wrap {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .who__photo {
    width: 100%;
    height: auto;
    display: block;
  }
  .who__stats {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    display: flex;
    padding: var(--space-xl);
    background: linear-gradient(to top, rgb(0 0 0 / 0.8), transparent);
  }
  .who__stat {
    flex: 1;
    text-align: center;
    padding-inline: var(--space-md);
  }
  .who__stat[data-divider] {
    border-inline-start: 1px solid var(--color-white-25);
  }
  .who__stat-value {
    color: var(--color-white);
  }
  .who__stat-label {
    color: var(--color-white);
    font-size: var(--type-body-lg-size);
    line-height: var(--type-body-lg-line);
    font-weight: var(--font-weight-bold);
  }

  /* ── Our Programs ──────────────────────────────────────────────────────── */
  .programs__intro {
    display: grid;
    gap: var(--space-sm);
    /* node 5990:4336 is a FIXED 674px column — not a round rem value, so it stays literal
       (same one-off as /ngo/program's intro). The 2px matters: the lead's natural width
       measures 672.39px, so a 42rem/672px column overflows it by 0.39px and wraps a
       single-line paragraph onto two. */
    max-width: 42.125rem;
    margin-inline: auto;
    margin-bottom: var(--space-4xl);
    text-align: center;
  }
  .programs__intro h2 {
    color: var(--color-text-default);
  }
  .programs__intro p.u-body-lg {
    color: var(--color-text-default);
  }
  .programs__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-xl);
  }
  .programs__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xl);
    /* node 7403:5261 padding is 48 block / 32 inline, NOT 48 all round — the inline 32 is what
       gives the copy its 572px measure (636 − 2 × 32). /ngo/program's identical card already
       had this right; Home was the outlier. */
    padding: var(--space-2xl) var(--space-lg);
    border-radius: var(--radius-md);
    text-align: center;

    /* Over the flat teal sits the design's GLASS overlay (node 12330:13796, the same
       `GLASS` component 5892:5757 the Consultancy service cards use): ten equal vertical
       panes, each a white→black→#626262 gradient at ~25% opacity in OVERLAY blend, with a
       2px black-at-2% divider down its right edge. The panes are `flex: 1` in the design,
       hence 10% tiles rather than fixed widths.

       Precomputed, not layered: the backdrop is one flat fill (--color-surface-inverse,
       #0E3E40), so the overlay result is a constant — no mix-blend-mode layer and no
       stacking context needed. Stops below are that constant, and the model was checked
       against the live Figma render at six positions across a tile, agreeing to within
       1/255 everywhere. The design's darkest stop lands at 73.00% here; the Consultancy
       card's comment says 74.56% for the same component, so one of the two is off — see
       the design-pass hand-off.

       The design also puts a 2.5px backdrop blur on each pane. Dropped for the same reason
       it was dropped on Consultancy: the panes sit above an opaque fill, so there is
       nothing behind them to blur — it would cost 40 backdrop-filter layers per section
       and change not one pixel.

       Only `background-image` is set here; the teal fill still comes from `.surface-inverse`
       (which also drives the on-inverse token flip), and this scoped rule outranks it, so
       the shorthand there no longer clears the overlay. */
    background-image:
      linear-gradient(
        to right,
        transparent 0,
        transparent calc(100% - 2px),
        rgb(0 0 0 / 0.02) calc(100% - 2px)
      ),
      linear-gradient(to right, #114d50 0%, #0b2f30 73%, #0d3a3c 100%);
    background-size: 10% 100%;
    background-repeat: repeat;
  }
  .programs__card-head {
    display: grid;
    gap: var(--space-md);
    justify-items: center;
    width: 100%;
  }
  .programs__card-title {
    font-family: var(--type-card-title-family);
    font-weight: var(--type-card-title-weight);
    font-size: var(--type-card-title-size);
    line-height: var(--type-card-title-line);
    letter-spacing: var(--type-card-title-tracking);
    color: var(--color-text-inverse);
  }
  .programs__divider {
    display: block;
    width: 100%;
    height: 1px;
    background: var(--color-border-on-inverse);
  }
  .programs__card-desc {
    color: var(--color-text-inverse);
    /* The design fixes this box at 71px with the copy vertically centred in it (node
       7403:5273: layoutSizingVertical FIXED, textAlignVertical CENTER) — all four cards
       carry the same 71, which is what makes the row's "Learn more" links line up and the
       card reach its designed 311px height. Reserved as a MIN height, not a fixed one:
       the design's box is `textAutoResize: TRUNCATE`, so copy longer than the box is
       clipped there, and we'd rather real copy grow the row than disappear. Same call, and
       the same reasoning, as .services__card's min-height on Consultancy. */
    min-height: 71px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* ── Success Stories ───────────────────────────────────────────────────── */
  .success__intro {
    display: grid;
    gap: var(--space-sm);
    max-width: 42rem;
    margin-bottom: var(--space-4xl);
  }
  .success__intro h2 {
    color: var(--color-text-default);
  }
  .success__intro p.u-body-lg {
    color: var(--color-text-default);
  }
  .success__video {
    position: relative;
    display: block;
    border-radius: var(--radius-md);
    overflow: hidden;
    margin-bottom: var(--space-6xl);
  }
  .success__video-img {
    width: 100%;
    height: auto;
    aspect-ratio: 1312 / 688;
    object-fit: cover;
    display: block;
  }
  .success__play {
    position: absolute;
    inset: 0;
    margin: auto;
    inline-size: 5rem;
    block-size: 5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.9);
    color: var(--color-surface-inverse);
  }
  .success__video:hover .success__play {
    background: var(--color-white);
  }

  .testimonial {
    display: grid;
    grid-template-columns: minmax(0, 437px) 1fr;
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .testimonial__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .testimonial__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xl);
    padding: var(--space-3xl);
  }
  .testimonial__quote {
    display: grid;
    gap: var(--space-sm);
    color: var(--color-text-inverse);
  }
  .testimonial__mark {
    font-size: 4rem;
    line-height: 1;
    font-weight: var(--font-weight-bold);
  }
  .testimonial__quote p {
    font-size: var(--type-lead-size);
    line-height: var(--type-lead-line);
    letter-spacing: var(--letter-spacing-h2);
  }
  .testimonial__attribution {
    display: grid;
    gap: var(--space-lg);
  }
  .testimonial__divider {
    display: block;
    height: 1px;
    background: var(--color-border-on-inverse);
  }
  .testimonial__name {
    font-weight: var(--font-weight-bold);
    font-size: var(--type-body-lg-size);
    color: var(--color-text-inverse);
  }
  .testimonial__role {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-2xs);
    font-size: var(--type-body-lg-size);
    color: var(--color-text-inverse);
  }
  .testimonial__attribution :global(.btn) {
    justify-self: start;
  }

  /* ── Recent News ───────────────────────────────────────────────────────── */
  .news__panel {
    display: grid;
    gap: var(--space-4xl);
  }
  .news__intro {
    display: grid;
    gap: var(--space-sm);
    align-content: start;
  }
  .news__intro h2 {
    color: var(--color-text-default);
  }
  .news__intro p.u-body-lg {
    color: var(--color-text-default);
  }
  .news__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
