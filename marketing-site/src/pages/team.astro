---
/**
 * Our Team (/team) — Consultancy. Built against the committed Figma node 8187:8979
 * (design/figma/fTqnnV20l9htP7vFJrOsvn/8187-8979/), see docs/consultancy-build-plan.md.
 *
 * Not linked from the shared header/footer nav (`src/lib/nav.ts`) — confirmed against Home's
 * own node.json in Phase 1 (not an oversight), so this route is intentionally unlinked but
 * still built, tested, and held to the same a11y/visual gates as every other route.
 *
 * Typography confirmed against node.json (not guessed):
 *   - Hero "Our Team": 64/56/700/-0.26 (`--font-size-hero` + `--line-height-h2`/
 *     `--letter-spacing-h2`) — the same one-off composition Services'/About's hero titles use,
 *     not the hero role's own 72px/-3.3. Same photo (imageRef `55fffb0d…`, the shared
 *     lecture-hall stock shot Home/About/Services already reuse) with a baked-in 25% black
 *     scrim, bottom-anchored/centred — reused verbatim from `.about-hero`.
 *   - No section heading precedes the team grid — confirmed by the node tree (the grid's
 *     parent, 8187:9246, has exactly two children: the grid and the CTA card; no heading/
 *     eyebrow node exists, hidden or otherwise). Unlike Home's "Core Team" section (which has
 *     an eyebrow+h2+paragraph intro before its 4-card row), Team jumps straight from the hero
 *     H1 into the grid. Confirmed per this page's own node.json, not assumed from Home's
 *     precedent — the build plan's instruction to check every recurring pattern per-page
 *     (About's `u-h2` vs `u-section-title` finding) applies here too.
 *   - Card name/role: node.json specifies **Inter** (name: 600/24/28.8/-0.48; role:
 *     400/16/22.4/0) — a different font family from the rest of the site's Arial-only system
 *     (`--font-family-base`, chosen in Phase 0 specifically to avoid any web-font load/FOUT).
 *     This exact card (same "His excellency" component, same imageRef, same "Julie Sande" /
 *     "Director General" placeholder copy) already ships on Home's Core Team section
 *     (`.team__card` in `index.astro`), where it was built as an Arial-inherited approximation
 *     (font-size matched exactly at 24px/16px; line-height/letter-spacing/font-family
 *     simplified). Matching that established, shipped precedent here for the identical
 *     component rather than introducing a second font family for one repeating card — the
 *     font-*sizes* (24px/16px) are honoured exactly; line-height/letter-spacing are composed
 *     from confirmed px values as one-off primitives (same technique as Services'/About's
 *     one-off compositions), font-family stays inherited (Arial).
 *   - CTA banner (eyebrow/heading/body/buttons): identical content, shape, and colours to
 *     Home's/Services'/About's CTA — including the same "Book Free ConsultationView All
 *     Services" copy/paste artifact trailing the paragraph in the source (trimmed here the same
 *     way) and the bold-italic accent-warm "First Step?" run (confirmed via
 *     `characterStyleOverrides`, override table entry "9" — italic, bold, `#E65320`). Button
 *     labels confirmed from the actual button-instance text nodes (not the paragraph's
 *     copy-paste artifact): "Book Consultancy" / "View all Services", exactly matching
 *     About's/Home's CTA buttons — reused verbatim.
 *
 * Content notes confirmed via node.json (not guessed):
 *   - All 10 member cards (4 + 4 + 2, matching the source's exact row split) carry the
 *     identical placeholder name/role/photo — same not-yet-personalised pattern as Home's Core
 *     Team (4×) and Services'/Home's other repeated content, reproduced as-is per
 *     exact-replica-first.
 *   - Grid gaps confirmed from node.json's auto-layout: 24px between cards in a row
 *     (`--space-md`), 80px between rows (`--space-4xl`) — a genuine distinction from Home's
 *     single-row Core Team section, which only ever needed one gap value.
 *
 * Component reuse considered: `ServiceDetailSection` (the ★ template) shapes a
 * title+subtitle/about-covers-cost block — Team's content (a photo grid + the shared CTA) isn't
 * that shape, so this page writes its own markup, same call as About's.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Button from '@components/Button.astro';
import { Image } from 'astro:assets';
import { teamHeroPhoto, teamMemberPhoto } from '@lib/team-images';

const team = Array.from({ length: 10 }, () => ({
  name: 'Julie Sande',
  role: 'Director General',
}));
---

<BaseLayout
  title="Our Team — GIEVA Consultancy"
  description="Meet the GIEVA Consultancy team guiding every student through their global education journey."
  brand="consultancy"
>
  <!-- ── Hero ─────────────────────────────────────────────────────────────────── -->
  <section class="team-hero">
    <div class="team-hero__media">
      <Image src={teamHeroPhoto} alt="" width={1440} height={670} class="team-hero__photo" />
      <div class="team-hero__scrim" aria-hidden="true"></div>
    </div>
    <div class="container team-hero__content">
      <h1 class="team-hero__heading">Our Team</h1>
    </div>
  </section>

  <!-- ── Team grid ────────────────────────────────────────────────────────────── -->
  <section class="section team-grid-section">
    <div class="container">
      <ul role="list" class="team-grid">
        {
          team.map((member) => (
            <li class="team-card">
              <Image
                src={teamMemberPhoto}
                alt=""
                width={310}
                height={380}
                class="team-card__photo"
              />
              <div class="team-card__info">
                <p class="team-card__name">{member.name}</p>
                <p class="team-card__role">{member.role}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ── CTA (same content/shape as Home's/Services'/About's) ───────────────────── -->
  <section class="section cta">
    <div class="container">
      <div class="cta__card surface-inverse" data-surface="inverse">
        <div class="cta__text">
          <p class="u-eyebrow">Get in Touch</p>
          <h2 class="u-section-title">
            Ready to Take Your <em class="u-accent-em">First Step?</em>
          </h2>
          <p class="u-body-lg">
            Book a free consultation with a GIEVA counselor today. No commitment, no pressure —
            just clarity on your path forward.
          </p>
        </div>
        <div class="cta__actions">
          <Button variant="primary" href="/book-consultancy" arrow={false}>
            Book Consultancy
          </Button>
          <Button variant="secondary" href="/services" arrow={false}>View all Services</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Shared section rhythm (matches Home/Services/About) ─────────────────── */
  .section {
    padding-block: var(--space-6xl);
  }

  /* ── Hero ───────────────────────────────────────────────────────────────── */
  .team-hero {
    position: relative;
  }
  .team-hero__media {
    position: relative;
  }
  .team-hero__photo {
    width: 100%;
    height: auto;
    display: block;
  }
  .team-hero__scrim {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0.25);
  }
  .team-hero__content {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: var(--space-6xl);
  }
  .team-hero__heading {
    margin: 0;
    color: var(--color-white);
    font-family: var(--font-family-base);
    font-size: var(--font-size-hero);
    line-height: var(--line-height-h2);
    letter-spacing: var(--letter-spacing-h2);
    font-weight: var(--font-weight-bold);
    text-align: center;
    overflow-wrap: anywhere;
  }

  /* ── Team grid ──────────────────────────────────────────────────────────── */
  .team-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: var(--space-md);
    row-gap: var(--space-4xl);
  }
  .team-card {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .team-card__photo {
    width: 100%;
    height: auto;
    aspect-ratio: 310 / 380;
    object-fit: cover;
    display: block;
  }
  .team-card__info {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    padding: var(--space-md);
    background: linear-gradient(to top, rgb(0 0 0 / 0.75), transparent);
    color: var(--color-white);
  }
  .team-card__name {
    margin: 0;
    font-weight: 600;
    font-size: 24px;
    line-height: 28.8px;
    letter-spacing: -0.48px;
  }
  .team-card__role {
    margin: 0;
    font-weight: var(--font-weight-regular);
    font-size: 16px;
    line-height: 22.4px;
    letter-spacing: 0;
  }

  /* ── CTA (same content/shape as Home's/Services'/About's) ──────────────── */
  .cta__card {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xl);
    padding: var(--space-3xl);
    border-radius: var(--radius-md);
  }
  .cta__text {
    display: grid;
    gap: var(--space-sm);
    max-width: 34rem;
  }
  .cta__actions {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  /* ── Responsive ─────────────────────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .team-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .team-hero__heading {
      font-size: var(--font-size-h3);
    }
    .team-grid {
      grid-template-columns: 1fr;
    }
    .cta__card {
      justify-content: center;
      text-align: center;
    }
    .cta__text {
      max-width: none;
    }
    .cta__actions {
      justify-content: center;
    }
  }
</style>
