  .faq__question::-webkit-details-marker {
    display: none;
  }
  .faq__toggle {
    flex: none;
    position: relative;
    inline-size: 1.25rem;
    block-size: 1.25rem;
  }
  .faq__toggle::before,
  .faq__toggle::after {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    background: var(--color-accent-warm);
