---
/**
 * Home (/) — Consultancy. Built against the committed Figma node 5891:4663
 * (design/figma/fTqnnV20l9htP7vFJrOsvn/5891-4663/), see docs/consultancy-build-plan.md.
 *
 * Content notes (leftover/duplicate nodes in the source were excluded — confirmed via each
 * node's `visible` flag, not guessed):
 *   - Several sections carry a hidden, unedited placeholder heading ("— Every Major Test.
 *     One Trusted Partner.") behind the real one — `visible: false` in node.json, omitted.
 *   - The closing CTA band is the shared `CtaSection.astro` — one Figma component instantiated
 *     identically here and on /services, /about and /team. See that file for the confirmed
 *     text (including its forced line break) and the copy/paste artifact it trims.
 *   - Core Team repeated one placeholder photo/name/role 4×, and the testimonial quote/name
 *     repeats 3× — that's the design's real (not-yet-personalised) content, kept as-is.
 *     **Core Team is CMS-driven as of 2026-08-14** (`@lib/staff`, the same source as /team,
 *     sliced to the design's four); the four placeholders live on as that module's fixtures, so
 *     a build with no `GIEVA_API_URL` still renders this section exactly as designed. The
 *     testimonials are still hard-coded — no CMS type backs them.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Button from '@components/Button.astro';
import PartnersMarquee from '@components/PartnersMarquee.astro';
import TeamCard from '@components/TeamCard.astro';
import CtaSection from '@components/CtaSection.astro';
import StatCounter from '@components/StatCounter.astro';
import { Image } from 'astro:assets';
import {
  heroRing,
  whoWeArePhoto,
  teamPhoto,
  testimonial1,
  testimonial2,
  testimonial3,
  partnerLogos,
} from '@lib/home-images';
import { getStaff } from '@lib/staff';
import { getFaqs } from '@lib/faqs';

const stats = [
  { value: '10,000+', label: 'Lives Changed' },
  { value: '30+', label: 'Global Partners' },
  { value: '12+', label: 'Years Active' },
  { value: '98%', label: 'Success Rate' },
];

/* All three cards share one description in the design — the service-card component's default,
   never overridden per instance (verified against every card in node.json and against a render
   of 6007:8054). It is placeholder copy from an unrelated project, so it will be replaced; kept
   verbatim meanwhile, including the blank line between its two paragraphs, which the card's
   3-line clamp cuts before it ever renders. */
const serviceDescription = `Peacebuilders rely on research as an important tool to enable them to study and understand conflict. It is also important to coordinate the various stakeholders to ensure the creation and sustenance of strategic partnerships.

By having research, coordination and partnership as an area of thematic focus, we aim to transition the state of negative to positive peace through sustained research, systematic documentation, robust coordination and strategic partnership.`;

const services = [
  { number: '01', title: 'Test Registration', description: serviceDescription },
  { number: '02', title: 'Study Abroad', description: serviceDescription },
  { number: '03', title: 'Professional Development', description: serviceDescription },
];

/* Core Team is a taster for /team, not a second roster: the design's section is a single row of
   four, so it takes the first four of the same CMS list rather than fetching its own slice. The
   backend already orders by `order ASC`, which is the field the dashboard exposes for exactly
   this — so "which four" is an editorial decision made in the admin UI, not here. */
const team = (await getStaff()).slice(0, 4);

const testimonialQuote =
  "The GIEVA team walked me through every step of my TOEFL registration. They even helped me pick test centres I didn't know existed. I got my scores in record time and reported them to my target schools the same week.";
/* `focus` sets the photo's `object-position`. The design's image fills are `scaleMode: FILL`
   with no `imageTransform`, i.e. Figma's default centre crop — the designer never made a
   framing decision, they inherited one. On these three portraits the default puts the quote
   (which starts 232px down a 520px card) straight across a face: measured from the source
   pixels, the face centre lands at ~150px on photo 1 but ~224px on photo 2 and ~261px on
   photo 3, and the design render (frame.png, ~y4834) shows exactly that. Cropping from the
   bottom lifts both faces clear. Photo 1's default crop already works, so it keeps it. */
const testimonials = [
  {
    photo: testimonial1,
    name: 'Tolulope Ogunwale',
    role: 'TOEFL CLIENT Admitted to University of Michigan',
  },
  {
    photo: testimonial2,
    name: 'Tolulope Ogunwale',
    role: 'TOEFL CLIENT Admitted to University of Michigan',
    focus: 'center bottom',
  },
  {
    photo: testimonial3,
    name: 'Tolulope Ogunwale',
    role: 'TOEFL CLIENT Admitted to University of Michigan',
    focus: 'center bottom',
  },
];

// CMS-driven as of 2026-08-15. The four questions the design ships live on as `@lib/faqs`'
// fixtures, so a build with no `GIEVA_API_URL` renders this section exactly as designed. Unlike
// Core Team above, the list is NOT sliced — see that module for why the accordion is allowed to
// grow and why the API's own ordering is kept.
const faqs = await getFaqs();
---

<BaseLayout
  title="GIEVA — Your Gateway to Global Academic Excellence"
  description="GIEVA's certified counselors guide every step of your international education journey — test registration, university admissions, and professional development."
  brand="consultancy"
>
  <!-- ── Hero ─────────────────────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__content">
        {
          /* Badge + headline + lead are one group in the mobile frame (node 12496:9737): a
            24px stack under a single 5px backdrop blur, which is what lets the violet copy sit
            legibly over the ring bleeding behind it. Desktop has no such grouping — the three
            are plain siblings of the 40px stack — so this wrapper is `display: contents` there
            and only becomes a box at the mobile tier. */
        }
        <div class="hero__copy">
          <span class="hero__badge">Educational Consultancy</span>
          {
            /* Hard line breaks mirror the design's forced separators (node 5898:5918:
              "Your Gateway to" / "Global Academic" / "Excellence."); the &nbsp; binds
              "Global Academic" so line 2 never splits. Explicit breaks over width-based
              wrapping keeps parity robust against font-metric drift. The mobile frame
              (12496:9740) keeps the same three lines. */
          }
          <h1 class="u-hero hero__heading">
            Your Gateway to<br />
            <em class="u-accent-em">Global</em>&nbsp;Academic<br />
            <em class="u-accent-em">Excellence.</em>
          </h1>
          <p class="u-body-lg hero__lead">
            From standardized test registration to university admissions — GIEVA's certified
            counselors guide every step of your international education journey.
          </p>
        </div>
        <div class="hero__actions">
          <Button variant="primary" href="/book-consultancy" arrow={false}
            >Book Consultancy</Button
          >
          <Button variant="secondary" href="/services" arrow={false}>Take Test</Button>
        </div>
      </div>

      <div class="hero__visual">
        <Image src={heroRing} alt="" width={818} height={818} class="hero__ring" />
        {
          /* The "Explore NGO" pill (node 5986:3665) now lives in BrandSwitchLink.astro,
            rendered by BaseLayout on every route. */
        }
      </div>
    </div>

    <PartnersMarquee logos={partnerLogos} />
  </section>

  <!-- ── Who We Are ───────────────────────────────────────────────────────────── -->
  <section class="section who">
    <div class="container who__block">
      <p class="u-eyebrow">Who We Are</p>
      <div class="who__grid">
        <h2 class="u-section-title who__heading">
          Global Integrated Education Volunteers Association (GIEVA)
        </h2>
        <div class="who__body">
          <p class="u-body-lg">
            Global Integrated Education Volunteers Association (GIEVA) was registered in 2006
            as a nonprofit organization to improve access to quality education and global
            learning opportunities among young Nigerians. Over the years, GIEVA has grown to
            serve over 1,000 young Nigerians annually, with a strong focus on inclusive
            education, digital empowerment, and youth development.
          </p>
          <Button variant="secondary" href="/about" arrow={false}>Learn more about us</Button>
        </div>
      </div>
    </div>

    <div class="container">
      <div class="who__photo-wrap">
        <Image src={whoWeArePhoto} alt="" width={1312} height={670} class="who__photo" />
        <div class="who__wash" aria-hidden="true"></div>
        <div class="who__frost" aria-hidden="true"></div>
        <ul role="list" class="who__stats">
          {
            stats.map((stat, i) => (
              <li class="who__stat" data-divider={i > 0 ? '' : undefined}>
                <p class="u-h2 who__stat-value">
                  <StatCounter value={stat.value} />
                </p>
                <p class="who__stat-label">{stat.label}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- ── Consultancy Services ─────────────────────────────────────────────────── -->
  <section class="section services">
    <div class="container">
      <div class="services__intro">
        <p class="u-eyebrow">Consultancy Services</p>
        <h2 class="u-section-title">
          We don't just register you. <br />We&nbsp;guide&nbsp;you <em class="u-accent-em"
            >all the way to acceptance.</em
          >
        </h2>
        <p class="u-body-lg">
          GIEVA handles your entire registration process — from account setup to score
          reporting — with certified guidance at every step.
        </p>
      </div>

      <ul role="list" class="services__grid">
        {
          services.map((service) => (
            <li class="services__card">
              <span class="services__number">{service.number}</span>
              {/* The title/divider/description group and its CTA form one block pinned to the
                  bottom of the card, 96px apart — the card's space-between only separates that
                  block from the number badge (node 6007:8055). */}
              <div class="services__card-foot">
                <div class="services__card-body">
                  <h3 class="services__card-title">{service.title}</h3>
                  <p class="u-body-lg services__card-desc">{service.description}</p>
                </div>
                <Button variant="link" href="/services">
                  Learn more
                </Button>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ── Core Team ────────────────────────────────────────────────────────────── -->
  {
    /* The whole section is conditional, unlike /team's in-place empty state. A page headed
       "Core Team — Intelligent Minds Leading the Way" above an empty grid is worse than no
       section at all, and Home (unlike /team) has five other sections that carry it. Only
       reachable with a configured-but-empty CMS, i.e. a transient state before the first member
       is published. */
    team.length > 0 && (
      <section class="section team">
        <div class="container">
          <div class="team__intro">
            <p class="u-eyebrow">Core Team</p>
            <h2 class="u-section-title">
              Intelligent Minds <em class="u-accent-em">Leading the Way.</em>
            </h2>
            <p class="u-body-lg">
              GIEVA handles your entire registration process — from account setup to score
              reporting — with certified guidance at every step.
            </p>
          </div>

          <ul role="list" class="team__grid">
            {team.map((member) => (
              <li>
                {/* No photo uploaded → the design's own placeholder portrait, a local asset that
                    goes through astro:assets. Same fallback as /team. */}
                <TeamCard
                  src={member.imageUrl ?? teamPhoto}
                  name={member.name}
                  role={member.role}
                />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- ── Testimonials ─────────────────────────────────────────────────────────── -->
  <section class="section testimonials">
    <div class="container">
      <div class="testimonials__intro">
        <div class="testimonials__intro-heading">
          <p class="u-eyebrow">Testimonials</p>
          <h2 class="u-section-title">
            What our clients have to say <em class="u-accent-em">about us</em>
          </h2>
        </div>
        <div class="testimonials__intro-body">
          <p class="u-body-lg">
            At GIEVA, we're committed to continuous growth and improvement. Whether you've
            participated in one of our programs, partnered with us, or simply explored our
            work—we want to hear from you!
          </p>
          <p class="u-body-lg">
            Your insights help us shape better experiences, expand our impact, and serve young
            people more effectively.
          </p>
          <Button variant="secondary" href="/feedback">Share your Feedback</Button>
        </div>
      </div>

      <ul role="list" class="testimonials__grid">
        {
          testimonials.map((t) => (
            <li>
              <figure class="testimonials__card">
                <Image
                  src={t.photo}
                  alt=""
                  width={421}
                  height={520}
                  class="testimonials__photo"
                  style={t.focus ? `object-position: ${t.focus}` : undefined}
                />
                <figcaption class="testimonials__card-body">
                  <blockquote class="testimonials__quote u-body-lg">
                    <p>“{testimonialQuote}”</p>
                  </blockquote>
                  <p class="testimonials__name u-lead">{t.name}</p>
                  <p class="testimonials__role u-body-lg">{t.role}</p>
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ── FAQ ──────────────────────────────────────────────────────────────────── -->
  {
    /* Rendered only when the CMS has published questions — same call as Core Team above: the
      intro column promising "Clear Answers." beside an empty accordion is worse than no section,
      and the "Chat with us" CTA it carries is already reachable from the nav and the closing CTA
      band. Only reachable with a configured-but-empty CMS; fixtures always have four. */
  }
  {
    faqs.length > 0 && (
      <section class="section faq">
        <div class="container faq__grid">
          <div class="faq__intro">
            <p class="u-eyebrow">FAQ</p>
            <h2 class="u-section-title">
              Common Questions, <em class="u-accent-em">Clear Answers.</em>
            </h2>
            <p class="u-body-lg">
              Still have questions? Our counselors are available Monday–Friday, 9am–5pm via
              WhatsApp, email, and in-person at our Abuja, Lagos, and Jos offices.
            </p>
            <Button variant="secondary" href="/contact">
              Chat with us
            </Button>
          </div>

          <div class="faq__list">
            {/* `name` groups these into an exclusive accordion — the browser closes the
                open sibling for us. Pre-2024 browsers ignore it and simply allow several
                open at once, which is the behaviour we had before. */}
            {faqs.map((faq) => (
              <details class="faq__item" name="faq">
                <summary class="faq__question">
                  {faq.question}
                  <span class="faq__toggle" aria-hidden="true" />
                </summary>
                <p class="u-body-lg faq__answer">{faq.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- ── CTA ──────────────────────────────────────────────────────────────────── -->
  <section class="section cta">
    <div class="container">
      <CtaSection />
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Shared section rhythm ──────────────────────────────────────────────── */
  .section {
    padding-block: var(--section-padding-block);
  }

  /* ── Hero ───────────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    background-image: repeating-linear-gradient(
      to right,
      rgb(0 0 0 / 0.02) 0,
      rgb(0 0 0 / 0.02) 1px,
      transparent 1px,
      transparent 60px
    );
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 656px) 1fr;
    align-items: center;
    gap: var(--space-2xl);
    padding-block: var(--space-6xl) var(--space-2xl);
  }
  .hero__content {
    display: grid;
    gap: var(--space-xl); /* 40px — design itemSpacing on the content stack (node 5891:4670) */
  }
  /* Transparent to layout on desktop: the badge, headline and lead stay direct children of the
     40px stack, exactly as before this wrapper existed. It becomes a real box only at the
     mobile tier (see the @media block). */
  .hero__copy {
    display: contents;
  }
  .hero__badge {
    display: inline-block;
    width: fit-content;
    padding: var(--space-3xs) var(--space-md);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    font-size: var(--type-body-size);
    /* Confirmed design value (node 5898:5920): #171717, distinct from body text
       --color-text-default (#292929). Composed inline as a page-local one-off. */
    color: #171717;
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-none); /* design ls=0, not the eyebrow's -0.16px */
  }
  .hero__heading {
    color: var(--color-violet);
    /* No max-width: the <br />s above control line breaks exactly (parity with node 5898:5918). */
  }
  .hero__lead {
    color: var(--color-violet);
    /* No narrow cap: the lead fills the 656px content column and wraps to 2 lines,
       matching the design (node 5891:5707 is 656px wide × 48px tall = 2 × 24px). */
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .hero__visual {
    position: relative;
  }
  .hero__ring {
    width: 100%;
    height: auto;
  }
  /* The 3D mark's light-orbit layer used to stack over .hero__ring here (2026-08-25). The
     hero is back on the drawn artwork; the orbit now lives only on /styleguide, at the 608px
     sheet and 16s duration it painted at here. See docs/enhancement-backlog.md E-02. */
  /* The cross-site "Explore NGO" pill's styles moved to BrandSwitchLink.astro. */

  /* ── Who We Are ─────────────────────────────────────────────────────────── */
  /* The eyebrow sits above BOTH columns (node 7152:5162), so the heading and the body copy
     start on the same baseline — it is not part of the left column. */
  .who__block {
    display: grid;
    gap: var(--space-sm);
    margin-bottom: var(--space-4xl);
  }
  /* Geometry from node 7152:5164: 640 / 40 / 632 columns inside the 1312 content column. */
  .who__grid {
    display: grid;
    grid-template-columns: minmax(0, 640px) 1fr;
    gap: var(--space-xl);
    align-items: start;
  }
  .who__heading {
    color: var(--color-violet);
  }
  /* 64px between the paragraph and its CTA (node 7152:5167, itemSpacing 64). */
  .who__body {
    display: grid;
    align-content: start;
    gap: var(--space-3xl);
  }
  .who__body p {
    color: var(--color-black); /* node 7152:5169 is pure black, not the default body grey */
  }
  .who__body :global(.btn) {
    justify-self: start;
  }

  /* The photo itself carries no corner radius in the design (node 7152:5182) — only the
     overlays do, so the wash keeps its 12px while the image stays square. */
  .who__photo-wrap {
    position: relative;
    overflow: hidden;
  }
  .who__photo {
    width: 100%;
    height: auto;
    display: block;
  }
  /* Top half: white @ 10% wash (node 7152:5183). */
  .who__wash {
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 50%;
    border-radius: var(--radius-md);
    background: var(--color-white-10);
    pointer-events: none;
  }
  /* Bottom half: progressive frost (node 7152:5184's BACKGROUND_BLUR, blurType PROGRESSIVE,
     radius ramping 0 at the top of the frame to 64 at the bottom). CSS has no progressive
     blur, so this stacks three uniform backdrop-filters, each faded in by a gradient mask
     that starts lower than the one below it — the overlap approximates the ramp far more
     smoothly than a single masked layer, which reads as a hard band. */
  .who__frost {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 50%;
    pointer-events: none;
  }
  .who__frost::before,
  .who__frost::after,
  .who__stats::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .who__frost::before {
    backdrop-filter: blur(4px);
    mask-image: linear-gradient(to bottom, transparent 0%, #000 45%);
  }
  .who__frost::after {
    backdrop-filter: blur(12px);
    mask-image: linear-gradient(to bottom, transparent 35%, #000 75%);
  }
  /* Bottom half: scrim + stats (node 7152:5184) — the gradient runs the full half-height and
     tops out at 32% black, so the photo stays readable underneath. */
  .who__stats {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 50%;
    display: flex;
    align-items: flex-end;
    /* 32px on the scrim + 32px on the inner row = 64px inset from the photo edge. */
    padding: var(--space-3xl);
    /* 40px each side of a zero-width divider ⇒ 80px between cards, giving 236px cards. */
    gap: calc(2 * var(--space-xl));
    background: linear-gradient(to bottom, transparent, rgb(0 0 0 / 0.32));
  }
  /* Deepest frost layer — also absorbs node 7152:5185's separate blur(10) behind the stat
     row, which is not worth a fourth stacked backdrop-filter on top of this. */
  .who__stats::before {
    backdrop-filter: blur(24px);
    mask-image: linear-gradient(to bottom, transparent 55%, #000 100%);
  }
  /* Safari < 18 only ships the prefixed property. It has to live in its own @supports block:
     Lightning CSS collapses a prefixed/standard pair written in the SAME declaration block
     down to just the prefixed one, silently dropping the standard property that Chrome and
     Firefox need (neither supports the -webkit- alias). Chrome fails this query, so it never
     sees these declarations. */
  @supports (-webkit-backdrop-filter: blur(1px)) {
    .who__frost::before {
      -webkit-backdrop-filter: blur(4px);
    }
    .who__frost::after {
      -webkit-backdrop-filter: blur(12px);
    }
    .who__stats::before {
      -webkit-backdrop-filter: blur(24px);
    }
  }
  .who__stat {
    position: relative;
    flex: 1;
    display: grid;
    gap: var(--space-md);
    align-content: center;
    justify-items: center;
    text-align: center;
    /* Design card is 236x168 with 32/64 padding, but its text nodes overflow that padding
       box rather than wrapping — so only the 32px block padding is load-bearing here. */
    padding-block: var(--space-lg);
  }
  /* Full-card-height hairline centred in the gap (nodes 7152:5192/5199/5206). */
  .who__stat[data-divider]::before {
    content: '';
    position: absolute;
    inset-block: 0;
    inset-inline-start: calc(-1 * var(--space-xl));
    width: 1px;
    background: var(--color-white);
  }
  .who__stat-value {
    color: var(--color-white);
  }
  .who__stat-label {
    color: var(--color-white);
    font-size: var(--type-body-lg-size);
    line-height: var(--type-body-lg-line);
    font-weight: var(--font-weight-bold);
    letter-spacing: normal; /* node 7152:5190 tracks at 0, unlike the -0.16px body default */
  }

  /* ── Consultancy Services ──────────────────────────────────────────────── */
  .services__intro {
    display: grid;
    gap: var(--space-sm);
    max-width: 817px; /* the design's text column (nodes 6007:8047/8049), not a round rem cap */
    margin-bottom: var(--space-4xl);
  }
  .services__intro h2 {
    color: var(--color-violet);
  }
  .services__intro p.u-body-lg {
    /* node 6007:8051 is #120633 — the heading violet, not the default body grey. */
    color: var(--color-violet);
  }
  .services__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }
  .services__card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    /* 555px tall in the design (node 6007:8057 is the fixed one, the other two fill to match).
       A min rather than a fixed height so real copy, once it replaces the placeholder, can grow
       the row instead of spilling out of the card. */
    min-height: 555px;
    padding: var(--space-lg) var(--space-lg) var(--space-3xl);
    border-radius: var(--radius-md);
    color: var(--color-white);
    /* #291E47 — the card fill. No published Figma name, so it stays a page-local one-off, same
       as .hero__badge's #171717 above.

       Over it sits the design's GLASS overlay (node 12290:8889): ten equal vertical panes, each
       a white→black→#626262 gradient at 25% opacity in OVERLAY blend, with a 2px black-at-2%
       divider down its right edge. Because the backdrop is this one flat fill, the blend result
       is a constant — precomputed below (overlay = 2 × base × blend for a base this dark, then
       mixed 25% with the fill) — so the stripes need no mix-blend-mode layer and no stacking
       context. The panes are `flex: 1` in the design, hence 10% tiles rather than fixed widths.

       The design also puts a 2.5px backdrop blur on each pane. Dropped deliberately: the panes
       sit above an opaque fill, so there is nothing behind them to blur — it would cost 30
       backdrop-filter layers per row and change not one pixel. */
    background-color: #291e47;
    background-image:
      linear-gradient(
        to right,
        transparent 0,
        transparent calc(100% - 2px),
        rgb(0 0 0 / 0.02) calc(100% - 2px)
      ),
      linear-gradient(to right, #332659 0%, #1f1735 74.56%, #271c43 100%);
    background-size: 10% 100%;
    background-repeat: repeat;
  }
  .services__number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 3.25rem;
    block-size: 3.25rem;
    border-radius: 50%;
    background: var(--color-accent-warm);
    font-weight: var(--font-weight-bold);
    font-size: 2rem;
  }
  .services__card-foot {
    display: grid;
    gap: var(--space-5xl); /* 96px — node I6007:8055;5977:4965 */
  }
  .services__card-body {
    display: grid;
    gap: var(--space-md);
  }
  .services__card-title {
    text-transform: uppercase;
    font-family: var(--type-card-title-family);
    font-weight: var(--type-card-title-weight);
    font-size: var(--type-card-title-size);
    line-height: var(--type-card-title-line);
    letter-spacing: var(--type-card-title-tracking);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--color-white-25);
  }
  .services__card-desc {
    color: var(--color-white);
    /* The design fixes this box at 71px with an ending ellipsis (node I6007:8055;4571:24846,
       textAutoResize TRUNCATE) — three lines, then "…". Only the -webkit- property is written:
       pairing it with the standard `line-clamp` in one block lets Lightning CSS collapse the
       two down to whichever it prefers, the same build-time trap that silently dropped
       backdrop-filter from the header pill. Every current browser supports this spelling. */
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
    /* Keeps the blank line between the description's two paragraphs meaningful even though the
       clamp cuts above it. */
    white-space: pre-line;
  }
  .services__card :global(.btn--link) {
    color: var(--color-accent-warm);
    /* Without this the link stretches to the grid column and .btn's own justify-content
       centres the label; the design has it flush with the card's content edge. */
    justify-self: start;
  }

  /* ── Core Team ──────────────────────────────────────────────────────────── */
  .team__intro {
    display: grid;
    /* 16px between eyebrow → heading → paragraph (node 6007:7880's auto-layout). */
    gap: var(--space-sm);
    /* Design's text column is exactly 676px (the heading and paragraph text nodes both
       measure 676 wide, centred in the 1312 container) — not a round rem value. */
    max-width: 676px;
    margin-inline: auto;
    margin-bottom: var(--space-4xl);
    text-align: center;
  }
  .team__intro h2 {
    color: var(--color-violet);
  }
  /* Node 6007:7890 fills this paragraph #120633, the same violet as the heading above it —
     not the default #292929 body ink. Confirmed against Home's node.json. */
  .team__intro p.u-body-lg {
    color: var(--color-violet);
  }
  .team__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
  }
  /* Card itself lives in `TeamCard.astro` — the canonical implementation shared with /team. */

  /* ── Testimonials ───────────────────────────────────────────────────────── */
  .testimonials__intro {
    display: grid;
    grid-template-columns: minmax(0, 636px) 1fr;
    gap: var(--space-xl);
    margin-bottom: var(--space-4xl);
  }
  .testimonials__intro-heading h2 {
    color: var(--color-violet);
  }
  .testimonials__intro-body {
    display: grid;
    gap: var(--space-md);
  }
  .testimonials__intro-body p {
    color: var(--color-text-default);
  }
  .testimonials__intro-body :global(.btn) {
    justify-self: start;
  }
  .testimonials__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }
  /* Card 421×520, square-cornered — the design's card frames carry no `cornerRadius` (we had
     been rounding them to 12px). Its 40/32 padding and flex-end stack reproduce the source
     geometry exactly: 144 + 16 + 32 + 8 + 48 = 248px of content over 40px of bottom padding
     puts the quote's first line 232px down, which is where node.json has it. */
  .testimonials__card {
    position: relative;
    overflow: hidden;
  }
  .testimonials__photo {
    width: 100%;
    height: auto;
    aspect-ratio: 421 / 520;
    object-fit: cover;
    display: block;
  }
  .testimonials__card-body {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--space-2xs);
    padding: var(--space-xl) var(--space-lg);
    color: var(--color-white);
    /* Phase-4 craft, and the one deliberate deviation in this section: the design's scrim is
       a flat black 40% over the whole card, which is both too dark over the face and too
       light under the text. Measured against the three source photos, composited and read
       back as WCAG relative luminance over the text column (x 32–389, y 232–480), white on
       the flat 40% scrim bottoms out at 2.97:1 on photo 3 — a real AA failure that axe
       cannot see, because it has no way to measure text over an image.

       This bottom-weighted ramp holds ≥ 0.58 alpha from 43% down, where the text starts,
       which measures 8.02 / 9.33 / 6.24:1 worst-pixel across the three photos (AAA on two
       of them) while leaving the face zone roughly twice as bright as the flat 40% did.
       Gradient scrims are already this design's own language — the team card's fills are
       transparent → rgb(0 0 0 / 0.32) top-to-bottom (see TeamCard.astro). Re-run the
       measurement when the placeholder portraits are replaced with real client photos. */
    background: linear-gradient(
      to bottom,
      rgb(0 0 0 / 0.06) 0%,
      rgb(0 0 0 / 0.12) 22%,
      rgb(0 0 0 / 0.26) 34%,
      rgb(0 0 0 / 0.58) 43%,
      rgb(0 0 0 / 0.68) 70%,
      rgb(0 0 0 / 0.76) 100%
    );
  }
  /* Decorative only — the card holds no link, so there is nothing to focus and nothing is
     conveyed by the motion. Add `:focus-within` alongside the hover if a "read the full
     story" link is ever added to the card. */
  .testimonials__photo {
    transition: transform 500ms ease;
  }
  .testimonials__card:hover .testimonials__photo {
    transform: scale(1.04);
  }
  @media (prefers-reduced-motion: reduce) {
    .testimonials__photo {
      transition: none;
    }
    .testimonials__card:hover .testimonials__photo {
      transform: none;
    }
  }
  /* Design gaps are 16px quote→name and 8px name→role. The 8px flex gap gives the latter;
     this margin adds the other 8px on top of it for the former. */
  .testimonials__quote {
    margin-bottom: var(--space-2xs);
  }
  /* .testimonials__name is `.u-lead` — 24/32/700/−1.2px is exactly the design's name style. */

  /* ── FAQ ────────────────────────────────────────────────────────────────── */
  .faq__grid {
    display: grid;
    grid-template-columns: minmax(0, 552px) 1fr;
    gap: var(--space-3xl);
  }
  .faq__intro {
    display: grid;
    gap: var(--space-sm);
    align-content: start;
  }
  .faq__intro h2 {
    color: var(--color-violet);
  }
  .faq__intro p.u-body-lg {
    color: var(--color-text-default);
  }
  .faq__intro :global(.btn) {
    justify-self: start;
    margin-top: var(--space-sm);
  }
  .faq__list {
    display: grid;
    align-content: start;
  }
  .faq__item {
    padding-block: var(--space-lg);
    border-bottom: 1px solid var(--color-border-subtle);
