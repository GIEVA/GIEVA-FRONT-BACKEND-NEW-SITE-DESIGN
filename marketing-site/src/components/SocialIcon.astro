---
/**
 * SocialIcon — simple, recognisable glyphs for the footer's social row (Home node.json
 * "oo-social-links → List"). Hand-authored rather than sliced from the flattened Figma
 * export so each icon stays an individually labelled, accessible link.
 *
 * Rendered at 24px, the size Figma gives the row (I8210:7883;8210:7826 → `size-[24px]`). These
 * previously shipped at 18px inside a 32px bordered circle; the design has no ring, so the
 * glyph itself now carries the whole visual — and, at 24px, the whole 2.5.8 target as well.
 */
interface Props {
  name: 'Instagram' | 'Facebook' | 'X (Twitter)' | 'LinkedIn' | 'YouTube';
}

const { name } = Astro.props;
---

{
  name === 'Instagram' && (
    <svg
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      aria-hidden="true"
      focusable="false"
    >
      <rect
        x="3"
        y="3"
        width="18"
        height="18"
        rx="5"
        stroke="currentColor"
        stroke-width="1.5"
      />
      <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5" />
      <circle cx="17.5" cy="6.5" r="1" fill="currentColor" />
    </svg>
  )
}
{
  name === 'Facebook' && (
    <svg
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      aria-hidden="true"
      focusable="false"
    >
      <path
        d="M15 8h2V4h-2a5 5 0 0 0-5 5v3H8v4h2v6h4v-6h3l1-4h-4V9a1 1 0 0 1 1-1Z"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linejoin="round"
      />
    </svg>
  )
}
{
  name === 'X (Twitter)' && (
    <svg
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      aria-hidden="true"
      focusable="false"
    >
      <path
        d="M4 4l7.5 9.5L4.5 20h2l6-6.5 4.6 6.5H20l-7.8-10L19 4h-2l-5.6 6L7 4H4Z"
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linejoin="round"
      />
    </svg>
  )
}
{
  name === 'LinkedIn' && (
    <svg
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      aria-hidden="true"
      focusable="false"
    >
      <rect
        x="3"
        y="3"
        width="18"
        height="18"
        rx="3"
        stroke="currentColor"
        stroke-width="1.5"
      />
      <circle cx="8" cy="8.5" r="1.25" fill="currentColor" />
      <path
        d="M8 11v6M12 17v-3.5c0-1.5 1-2.5 2.5-2.5S17 12 17 13.5V17"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
      />
    </svg>
  )
}
{
  name === 'YouTube' && (
    <svg
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      aria-hidden="true"
      focusable="false"
    >
      <rect
        x="3"
        y="6"
        width="18"
        height="12"
        rx="4"
        stroke="currentColor"
        stroke-width="1.5"
      />
      <path d="M10.5 9.5v5l4.5-2.5-4.5-2.5Z" fill="currentColor" />
    </svg>
  )
}
