---
/**
 * Trusted-partners logo marquee — an auto-scrolling, greyscale strip of partner logos with a
 * fixed left-hand label. Shared by the Consultancy (/) and NGO (/ngo) homes, which pass the
 * same `partnerLogos` set. Built against Figma node 12023:32440 (label ink #120633, 60px logo
 * band, full-opacity greyscale marks).
 *
 * A11y: the visible label names the strip; the first pass of logos carries each partner's name
 * as alt text, while the duplicated (scroll-loop) pass is aria-hidden with empty alt so screen
 * readers hear each partner once. The scroll respects prefers-reduced-motion.
 *
 * Each <Image> is given only a height — Astro derives the width from the source's own aspect
 * ratio. Pinning a fixed width too would force a mismatched canvas that sharp crops (cover),
 * clipping wide/short marks (e.g. ETS, UJ).
 *
 * Two logos carry a `crop` (see PartnerLogo in @lib/home-images): their export is mostly
 * transparent padding and the design shows only a sub-region. Those get an item box sized to
 * the crop with the image scaled up and offset inside it, so the visible mark fills the band
 * like every other logo does. They're also emitted at native resolution rather than downscaled
 * to the row height, since only a slice of those pixels survives the crop.
 */
import { Image } from 'astro:assets';
import type { PartnerLogo } from '@lib/home-images';

interface Props {
  logos: PartnerLogo[];
  /** Visible label to the left of the strip. */
  label?: string;
}

const { logos, label = 'Trusted Partners' } = Astro.props;
---

<div class="partners">
  <div class="container partners__row">
    <p class="u-eyebrow partners__label">{label}</p>
    <div class="partners__viewport">
      <ul role="list" class="partners__track">
        {
          [...logos, ...logos].map((logo, i) => {
            const hidden = i >= logos.length;
            const alt = hidden ? '' : logo.name;
            const meta = typeof logo.src === 'string' ? null : logo.src;
            const crop = meta ? logo.crop : undefined;
            // Width the crop occupies at the row height, from the source's own pixel dims —
            // derived rather than hard-coded so it stays correct if `height` is ever retuned.
            const cropW = crop
              ? (logo.height * (crop.width * meta!.width)) / (crop.height * meta!.height)
              : 0;
            const style = crop
              ? [
                  `--logo-h: ${logo.height}px`,
                  `--logo-w: ${cropW.toFixed(2)}px`,
                  `--crop-x: ${crop.x}`,
                  `--crop-y: ${crop.y}`,
                  `--crop-w: ${crop.width}`,
                  `--crop-h: ${crop.height}`,
                ].join('; ')
              : `--logo-h: ${logo.height}px`;
            return (
              <li
                class:list={['partners__item', crop && 'partners__item--crop']}
                style={style}
                aria-hidden={hidden ? 'true' : undefined}
              >
                {/* Eager, not lazy: the track is ~2x the viewport, so lazy-loaded logos sit
                    blank off-screen and pop in mid-scroll ("blink into existence"). They're
                    tiny; fetchpriority=low keeps them from competing with the hero LCP. */}
                {/* draggable=false: an <img> is natively draggable, so a press-and-move on a
                    logo tears off a ghost image instead of doing nothing, which on a strip
                    that is already sliding reads as the page coming apart. */}
                {typeof logo.src === 'string' ? (
                  <img
                    src={logo.src}
                    alt={alt}
                    loading="eager"
                    fetchpriority="low"
                    draggable={false}
                  />
                ) : (
                  <Image
                    src={logo.src}
                    alt={alt}
                    height={crop ? meta!.height : logo.height}
                    loading="eager"
                    fetchpriority="low"
                    draggable={false}
                  />
                )}
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
</div>

<style>
  .partners {
    padding-block: var(--space-lg) var(--space-2xl);
    /* Every logo's per-item height (set inline from @lib/home-images) is multiplied by this, so
       the whole strip resizes from one number instead of a second set of per-logo values. */
    --partner-logo-scale: 1;
  }
  .partners__row {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }
  .partners__label {
    flex: none;
    /* Design node 12023:32442 — this label is near-black ink (#120633), NOT the page's green
       eyebrow, so override the .u-eyebrow colour. It also sits on a faint left-edge vignette
       (16% black, right→left) with a backdrop blur, rather than plain white. */
    color: var(--color-text-default);
    padding: var(--space-md) var(--space-sm);
    background-image: linear-gradient(270deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.16) 100%);
    backdrop-filter: blur(16px);
  }
  .partners__viewport {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    mask-image: linear-gradient(
      to right,
      transparent,
      black var(--space-lg),
      black 95%,
      transparent
    );
  }
  .partners__track {
    display: flex;
    align-items: center;
    gap: var(--space-2xl);
    width: max-content;
    padding-inline-end: var(--space-2xl);
    animation: partners-scroll 36s linear infinite;
    /* Dragging across the page highlighted the logos — the strip is moving, so there is nothing
       here anyone means to select, and the highlight just reads as a glitch. Scoped to the track
       rather than the whole strip so the "Trusted Partners" label stays selectable; there is no
       reason to stop someone copying real text. */
    user-select: none;
  }
  /* Safari needed -webkit-user-select for years, and this build adds no prefixes of its own
     (no browserslist config). It has to sit in its own block: Lightning CSS collapses a
     prefixed/standard pair written together down to whichever comes LAST — it kept the standard
     property here and kept the prefixed one in 370d37c's backdrop-filter, which is the same
     rule seen from both sides. Verified against dist: both spellings survive this way. */
  @supports (-webkit-user-select: none) {
    .partners__track {
      -webkit-user-select: none;
    }
  }
  .partners__item {
    display: flex;
    align-items: center;
    flex: none;
    block-size: calc(var(--logo-h) * var(--partner-logo-scale));
  }
  .partners__item :global(img) {
    height: 100%;
    width: auto;
    object-fit: contain;
    /* Design renders logos as full-opacity greyscale (node 12023:32445); no additional fade. */
    filter: grayscale(1);
  }
  /* Reproduces Figma's crop fill. The box is the crop's own size; inside it the full image is
     blown up to 1/crop of that box (so the crop region lands at exactly box size) and slid back
     by the crop's origin. The translate percentages resolve against the img's *own* scaled
     size, which is what makes the two cancel out to the right offset. */
  .partners__item--crop {
    position: relative;
    inline-size: calc(var(--logo-w) * var(--partner-logo-scale));
    overflow: hidden;
  }
  .partners__item--crop :global(img) {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    width: calc(100% / var(--crop-w));
    height: calc(100% / var(--crop-h));
    max-inline-size: none;
    object-fit: fill;
    transform: translate(calc(var(--crop-x) * -100%), calc(var(--crop-y) * -100%));
  }
  @keyframes partners-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .partners__track {
      animation: none;
    }
  }

  /* ── Mobile (node 12496:9745) ─────────────────────────────────────────────────
     On desktop the strip is a band of its own under the hero. On mobile it is the last 46px of
     the hero frame itself — flush, no padding of its own — and every logo drops to exactly 2/3
     of its desktop height (the design's 60px band becomes 40px, and each individual mark
     divides through: Microsoft 40→26.67, WAEC 60→40, and so on for all thirteen). One scale
     factor reproduces the whole set, which is why the per-logo heights in @lib/home-images stay
     untouched. */
  @media (max-width: 640px) {
    .partners {
      padding-block: 0;
      --partner-logo-scale: calc(2 / 3);
    }
    .partners__row {
      gap: var(--space-sm);
    }
    .partners__label {
      /* 176×46 box around a 123×14 label — i.e. 16px block padding and the 26.5px each side
         that centres it (node 12496:9746). */
      padding: var(--space-sm) 26.5px;
    }
    .partners__viewport {
      /* The desktop mask fades 32px in from the left, which on a 350px row eats a tenth of the
         strip. The design fades only at the trailing edge here. */
      mask-image: linear-gradient(to right, black 90%, transparent);
    }
    .partners__track {
      gap: var(--space-lg);
      padding-inline-end: var(--space-lg);
    }
  }
</style>
