---
/**
 * BrandLockup — the GIEVA.org logotype: circular mark + "GIEVA" + green ".org".
 *
 * One component because the same Figma lockup is instanced in the Consultancy header
 * (5891:5463), the NGO header, and the footer (I8210:7883;8210:7763) — and the three
 * page-local copies had already drifted: the footer was rendering 32px bold Arial against the
 * header's confirmed 48px SemiBold Open Sans, so the *same* logo looked like two different
 * marks on one page. Per CLAUDE.md, a repeated Figma component becomes one Astro component.
 *
 * Geometry (confirmed identical in the Consultancy header, the NGO header and the footer):
 *   mark 48×48 circle · "GIEVA" 48/40 SemiBold, brand face · ".org" 32/27 Regular, green
 *   · 2px gap · text bottom-aligned (Figma `items-end`) · 247px overall.
 * The `.org` is a nested inline span rather than a flex sibling, so the browser's own baseline
 * alignment does the bottom-align — matching what the design shows without hand-tuned offsets.
 *
 * There used to be a `size="sm"` variant (40px mark / 28px bold) here, carried over from the
 * NGO header as it shipped and explicitly marked unconfirmed. The NGO header nodes have since
 * been ingested (7429:5891 and its four siblings) and every one instances the *same* 247×48
 * lockup as Consultancy — so the small treatment was never a design value, and is gone. One
 * size, because the design has one.
 */
import { Image } from 'astro:assets';
import { logoMark } from '@lib/home-images';

interface Props {
  /** Where the lockup links. Consultancy → "/", NGO → "/ngo". */
  href: string;
  /**
   * Ink for the "GIEVA" word. `brand` is the fixed deep-violet logotype ink on light surfaces,
   * `inverse` is white on dark. The ".org" is always green in every instance.
   */
  ink?: 'brand' | 'inverse' | 'default';
  /**
   * Visually-hidden tail on the accessible name, so the link reads "GIEVA.org — go to <this>"
   * rather than leaving the destination implicit in the logotype alone.
   */
  destination?: string;
  /**
   * Extra class, as a stable hook for callers. Note that Astro does NOT extend a parent's scope
   * hash to a child component's root, so a parent's scoped `.that-class { … }` rule will never
   * match this element — style through `:global()`, or add the case here. The layout defaults
   * every caller so far needed (`flex: none`, `justify-self: start`) are set below instead.
   */
  class?: string;
}

const { href, ink = 'brand', destination = 'home page', class: className } = Astro.props;
---

<a class:list={['brand-lockup', `brand-lockup--${ink}`, className]} href={href}>
  <Image src={logoMark} alt="" width={48} height={48} class="brand-lockup__mark" />
  <span class="brand-lockup__wordmark">GIEVA<span class="brand-lockup__tld">.org</span></span>
  <span class="visually-hidden"> — go to {destination}</span>
</a>

<style>
  .brand-lockup {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    text-decoration: none;
    /* A logotype should never be squeezed by a flex row (both headers) nor stretched across a
       grid track (the footer, where stretching would make the whole row one giant link target).
       `justify-self` is inert in flex layout, so the pair is safe in every container. */
    flex: none;
    justify-self: start;
  }
  .brand-lockup__mark {
    border-radius: 50%;
  }

  .brand-lockup__wordmark {
    font-family: var(--font-family-brand);
    font-weight: var(--font-weight-semibold);
    font-size: 3rem; /* 48px */
    line-height: 0.8333; /* 40/48 (design) */
  }

  /* Sized as a ratio of the wordmark rather than in absolute rem, so the lockup scales as one
     object: 48 × 0.6667 = the design's 32px, 32 × 0.84375 = its 27px line-height. The mobile
     step below then only has to move one number. */
  .brand-lockup__tld {
    font-size: 0.6667em;
    line-height: 0.84375;
    color: var(--color-feedback-success);
    font-weight: var(--font-weight-regular);
  }

  /* Mobile step — now CONFIRMED. This used to be ours (40px mark / 28px wordmark below 560px),
     authored only to keep the 247px lockup from overflowing a 320px viewport. The Consultancy
     mobile frame (node I12490:11661;5857:4414 et al) settles it: 24px mark, 24px "GIEVA",
     16px ".org", in a 124×24 lockup.

     Only the wordmark size moves, because the design's mobile ratios are the desktop ones
     exactly — 20/24 leading is the same 0.8333 as 40/48, and 16/24 is the same 0.6667 the
     `.org` already derives — so the whole lockup scales as one object off this single number.
     Breakpoint moved 560 → 640 to land on the site-wide mobile tier (tokens.css §4). */
  @media (max-width: 640px) {
    .brand-lockup__mark {
      inline-size: 1.5rem;
      block-size: 1.5rem;
    }
    .brand-lockup__wordmark {
      font-size: 1.5rem; /* 24px */
    }
  }

  /* The logotype violet is fixed brand ink, not a themeable text role — hence the primitive. */
  .brand-lockup--brand .brand-lockup__wordmark {
    color: var(--color-violet);
  }
  .brand-lockup--inverse .brand-lockup__wordmark {
    color: var(--color-text-inverse);
  }
  .brand-lockup--default .brand-lockup__wordmark {
    color: var(--color-text-default);
  }
</style>
